{
  "name": "mp3-tagger",
  "version": "1.2.0",
  "description": "Zaawansowany edytor tagów MP3 z polskim interfejsem",
  "homepage": "https://github.com/PaffcioStudio/mp3-tagger",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build": "electron-builder --linux",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui-smoke.cjs"
  },
  "keywords": [
    "mp3",
    "tag",
    "metadata",
    "audio",
    "id3",
    "music",
    "editor"
  ],
  "author": {
    "name": "Paweł Potrykus (Paffcio)",
    "url": "https://github.com/PaffcioStudio/mp3-tagger"
  },
  "license": "MIT",
  "dependencies": {
    "node-id3": "^0.2.6"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mp3tagger.app",
    "productName": "MP3 Tagger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "snap",
        "tar.gz"
      ],
      "category": "AudioVideo",
      "icon": "build/icons",
      "synopsis": "Zaawansowany edytor tagów MP3",
      "description": "Nowoczesna aplikacja do zarządzania tagami ID3 w plikach MP3",
      "maintainer": "Paweł Potrykus <https://github.com/PaffcioStudio>",
      "executableName": "mp3-tagger",
      "executableArgs": [
        "--no-sandbox"
      ],
      "desktop": {
        "entry": {
          "Icon": "mp3-tagger",
          "Name": "MP3 Tagger",
          "Type": "Application",
          "Categories": "AudioVideo;Audio;AudioVideoEditing;",
          "MimeType": "audio/mpeg;audio/mp3;",
          "StartupWMClass": "mp3-tagger"
        }
      },
      "syncDesktopName": true,
      "mimeTypes": [
        "audio/mpeg",
        "audio/mp3"
      ]
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3"
      ],
      "fpm": [
        "--license",
        "MIT",
        "--vendor",
        "Paweł Potrykus (Paffcio)",
        "--url",
        "https://github.com/PaffcioStudio/mp3-tagger"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "copyright": "Copyright © 2025 Paweł Potrykus (Paffcio)",
    "snapcraft": {
      "base": "core22",
      "core22": {
        "grade": "stable",
        "confinement": "classic"
      }
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "afterPack": "build/after-pack.cjs"
  },
  "bugs": {
    "url": "https://github.com/PaffcioStudio/mp3-tagger/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PaffcioStudio/mp3-tagger.git"
  },
  "desktopName": "mp3-tagger.desktop",
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
