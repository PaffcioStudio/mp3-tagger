[Desktop Entry]
Name=MP3 Tagger
GenericName=Audio Tag Editor
GenericName[pl]=Edytor tagów audio
Comment=Edit audio file ID3 tags
Comment[pl]=Edytuj tagi ID3 w plikach audio
Exec=mp3-tagger %F
Icon=mp3-tagger
Terminal=false
Type=Application
Categories=AudioVideo;Audio;AudioVideoEditing;
MimeType=audio/mpeg;audio/mp3;
Keywords=mp3;tag;metadata;audio;id3;music;
Keywords[pl]=mp3;tag;metadane;audio;id3;muzyka;
StartupWMClass=mp3-tagger
StartupNotify=true
